+
+#pragma once
+
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+
+typedef struct {
+	gchar		*name;		/* e.g. "libfoo" */
+	gchar		*pkgver;	/* e.g. "libfoo-1.2.3_1" */
+	gchar		*version;	/* e.g. "1.2.3_1" */
+	gchar		*summary;	/* (nullable) */
+	gboolean	 installed;
+} GsXbpsPackage;
+
+GsXbpsPackage	*gs_xbps_package_new		(const gchar	*pkgver,
+						 const gchar	*summary,
+						 gboolean	 installed);
+void		 gs_xbps_package_free		(GsXbpsPackage	*pkg);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (GsXbpsPackage, gs_xbps_package_free)
+
+gchar		*gs_xbps_pkgver_get_name	(const gchar	*pkgver);
+gchar		*gs_xbps_pkgver_get_version	(const gchar	*pkgver);
+
+guint64		 gs_xbps_parse_size		(const gchar	*size_str);
+
+/* Parsers; returned arrays have free func gs_xbps_package_free. */
+GPtrArray	*gs_xbps_parse_query_list	(const gchar	*output);
+GPtrArray	*gs_xbps_parse_query_search	(const gchar	*output);
+GPtrArray	*gs_xbps_parse_install_output	(const gchar	*output);
+/* key -> value map of an `xbps-query -R` result. */
+GHashTable	*gs_xbps_parse_info		(const gchar	*output);
+
+gboolean	 gs_xbps_is_available		(void);
+gboolean	 gs_xbps_package_is_owned	(const gchar	*name);
+gboolean	 gs_xbps_package_is_installed	(const gchar	*name);
+
+void		 gs_xbps_run_async		(const gchar * const *argv,
+						 GCancellable	*cancellable,
+						 GAsyncReadyCallback callback,
+						 gpointer	user_data);
+gboolean	 gs_xbps_run_finish		(GAsyncResult	*result,
+						 gchar		**out_stdout,
+						 gchar		**out_stderr,
+						 GError		**error);
+
+G_END_DECLS
