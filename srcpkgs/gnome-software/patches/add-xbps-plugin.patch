+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <config.h>
+
+#include <gio/gio.h>
+#include <glib.h>
+#include <string.h>
+
+#include "gs-xbps-utils.h"
+
+GsXbpsPackage *
+gs_xbps_package_new (const gchar *pkgver, const gchar *summary, gboolean installed)
+{
+	GsXbpsPackage *pkg = g_new0 (GsXbpsPackage, 1);
+
+	pkg->pkgver = g_strdup (pkgver);
+	pkg->name = gs_xbps_pkgver_get_name (pkgver);
+	pkg->version = gs_xbps_pkgver_get_version (pkgver);
+	pkg->summary = g_strdup (summary);
+	pkg->installed = installed;
+
+	return pkg;
+}
+
+void
+gs_xbps_package_free (GsXbpsPackage *pkg)
+{
+	if (pkg == NULL)
+		return;
+	g_free (pkg->name);
+	g_free (pkg->pkgver);
+	g_free (pkg->version);
+	g_free (pkg->summary);
+	g_free (pkg);
+}
+
+/* The pkgname may itself contain '-', so the split point is the last '-'
+ * which is followed by a version containing no further '-'. This matches
+ * xbps-uhelper getpkgname on the full installed set. */
+gchar *
+gs_xbps_pkgver_get_name (const gchar *pkgver)
+{
+	const gchar *p;
+
+	g_return_val_if_fail (pkgver != NULL, NULL);
+
+	for (p = pkgver; *p != '\0'; p++) {
+		if (*p == '-' && g_ascii_isdigit (p[1]) &&
+		    strchr (p + 1, '-') == NULL)
+			return g_strndup (pkgver, p - pkgver);
+	}
+
+	return g_strdup (pkgver);
+}
+
+gchar *
+gs_xbps_pkgver_get_version (const gchar *pkgver)
+{
+	g_autofree gchar *name = NULL;
+
+	g_return_val_if_fail (pkgver != NULL, NULL);
+
+	name = gs_xbps_pkgver_get_name (pkgver);
+	if (g_strcmp0 (name, pkgver) == 0 || pkgver[strlen (name)] != '-')
+		return g_strdup ("");
+
+	return g_strdup (pkgver + strlen (name) + 1);
+}
+
+guint64
+gs_xbps_parse_size (const gchar *size_str)
+{
+	gchar *end = NULL;
+	guint64 value;
+	guint64 multiplier = 1;
+
+	if (size_str == NULL)
+		return 0;
+
+	value = g_ascii_strtoull (size_str, &end, 10);
+	if (end == size_str)
+		return 0;
+
+	while (g_ascii_isspace (*end))
+		end++;
+
+	switch (g_ascii_toupper (*end)) {
+	case 'K':
+		multiplier = 1024ULL;
+		break;
+	case 'M':
+		multiplier = 1024ULL * 1024ULL;
+		break;
+	case 'G':
+		multiplier = 1024ULL * 1024ULL * 1024ULL;
+		break;
+	case 'T':
+		multiplier = 1024ULL * 1024ULL * 1024ULL * 1024ULL;
+		break;
+	default:
+		break;
+	}
+
+	return value * multiplier;
+}
+
+/* Duplicate the next whitespace-delimited token of @line and return a
+ * pointer to the start of the following token (or the terminating NUL). */
+static gchar *
+token_dup (const gchar *line, const gchar **rest_out)
+{
+	const gchar *start = line;
+	const gchar *end;
+
+	while (g_ascii_isspace (*start))
+		start++;
+	end = start;
+	while (*end != '\0' && !g_ascii_isspace (*end))
+		end++;
+
+	if (rest_out != NULL) {
+		const gchar *rest = end;
+		while (g_ascii_isspace (*rest))
+			rest++;
+		*rest_out = rest;
+	}
+
+	return g_strndup (start, end - start);
+}
+
+GPtrArray *
+gs_xbps_parse_query_list (const gchar *output)
+{
+	g_autoptr(GPtrArray) pkgs = g_ptr_array_new_with_free_func ((GDestroyNotify) gs_xbps_package_free);
+	g_auto(GStrv) lines = g_strsplit (output != NULL ? output : "", "\n", -1);
+
+	/* Format: "ii <pkgver>   <short_desc>". `xbps-query -l` only lists
+	 * installed packages; the two state characters are informational. */
+	for (guint i = 0; lines[i] != NULL; i++) {
+		const gchar *rest = lines[i];
+		g_autofree gchar *flags = NULL;
+		g_autofree gchar *pkgver = NULL;
+
+		if (lines[i][0] == '\0')
+			continue;
+
+		flags = token_dup (rest, &rest);
+		if (*flags == '\0')
+			continue;
+		pkgver = token_dup (rest, &rest);
+		if (*pkgver == '\0')
+			continue;
+
+		g_ptr_array_add (pkgs, gs_xbps_package_new (pkgver, rest, TRUE));
+	}
+
+	return g_steal_pointer (&pkgs);
+}
+
+GPtrArray *
+gs_xbps_parse_query_search (const gchar *output)
+{
+	g_autoptr(GPtrArray) pkgs = g_ptr_array_new_with_free_func ((GDestroyNotify) gs_xbps_package_free);
+	g_auto(GStrv) lines = g_strsplit (output != NULL ? output : "", "\n", -1);
+
+	/* Format: "[*] <pkgver>   <short_desc>" (installed) or "[-] ...". */
+	for (guint i = 0; lines[i] != NULL; i++) {
+		const gchar *line = lines[i];
+		const gchar *close;
+		const gchar *rest;
+		gboolean installed;
+		g_autofree gchar *pkgver = NULL;
+
+		if (line[0] != '[')
+			continue;
+		close = strchr (line, ']');
+		if (close == NULL)
+			continue;
+
+		installed = (line[1] == '*');
+
+		rest = close + 1;
+		pkgver = token_dup (rest, &rest);
+		if (*pkgver == '\0')
+			continue;
+
+		g_ptr_array_add (pkgs, gs_xbps_package_new (pkgver, rest, installed));
+	}
+
+	return g_steal_pointer (&pkgs);
+}
+
+GPtrArray *
+gs_xbps_parse_install_output (const gchar *output)
+{
+	g_autoptr(GPtrArray) pkgs = g_ptr_array_new_with_free_func ((GDestroyNotify) gs_xbps_package_free);
+	g_auto(GStrv) lines = g_strsplit (output != NULL ? output : "", "\n", -1);
+
+	/* Format: "<pkgver> <action> <arch> <repo> <dlsize> <instsize>" */
+	for (guint i = 0; lines[i] != NULL; i++) {
+		const gchar *rest = lines[i];
+		g_autofree gchar *pkgver = NULL;
+		g_autofree gchar *action = NULL;
+
+		if (lines[i][0] == '\0')
+			continue;
+
+		pkgver = token_dup (rest, &rest);
+		if (*pkgver == '\0')
+			continue;
+		action = token_dup (rest, &rest);
+		if (g_strcmp0 (action, "update") != 0)
+			continue;
+
+		g_ptr_array_add (pkgs, gs_xbps_package_new (pkgver, NULL, FALSE));
+	}
+
+	return g_steal_pointer (&pkgs);
+}
+
+GHashTable *
+gs_xbps_parse_info (const gchar *output)
+{
+	g_autoptr(GHashTable) props = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+	g_auto(GStrv) lines = g_strsplit (output != NULL ? output : "", "\n", -1);
+
+	for (guint i = 0; lines[i] != NULL; i++) {
+		const gchar *line = lines[i];
+		const gchar *colon;
+		g_autofree gchar *key = NULL;
+		gchar *value;
+
+		/* Multi-line values (provides, run_depends, …) are continuations
+		 * and are not needed for refinement. */
+		if (line[0] == '\0' || g_ascii_isspace (line[0]))
+			continue;
+
+		colon = strchr (line, ':');
+		if (colon == NULL)
+			continue;
+
+		key = g_strndup (line, colon - line);
+		value = g_strdup (colon + 1);
+		g_strstrip (value);
+		g_hash_table_replace (props, g_steal_pointer (&key), value);
+	}
+
+	return g_steal_pointer (&props);
+}
+
+gboolean
+gs_xbps_is_available (void)
+{
+	return g_file_test ("/usr/bin/xbps-query", G_FILE_TEST_IS_EXECUTABLE) &&
+	       g_file_test ("/usr/bin/xbps-install", G_FILE_TEST_IS_EXECUTABLE) &&
+	       g_file_test ("/usr/bin/xbps-remove", G_FILE_TEST_IS_EXECUTABLE);
+}
+
+gboolean
+gs_xbps_package_is_owned (const gchar *name)
+{
+	const gchar *argv[] = { "/usr/bin/xbps-query", "-R", name, NULL };
+	g_autoptr(GSubprocess) subprocess = NULL;
+	g_autoptr(GError) local_error = NULL;
+	g_autofree gchar *stdout_buf = NULL;
+	g_autofree gchar *stderr_buf = NULL;
+
+	g_return_val_if_fail (name != NULL, FALSE);
+
+	subprocess = g_subprocess_newv (argv,
+					G_SUBPROCESS_FLAGS_STDOUT_PIPE |
+					G_SUBPROCESS_FLAGS_STDERR_PIPE,
+					&local_error);
+	if (subprocess == NULL) {
+		g_debug ("Failed to run xbps-query: %s", local_error->message);
+		return FALSE;
+	}
+
+	if (!g_subprocess_communicate_utf8 (subprocess, NULL, NULL,
+					    &stdout_buf, &stderr_buf, &local_error)) {
+		g_debug ("Failed to run xbps-query: %s", local_error->message);
+		return FALSE;
+	}
+
+	return g_subprocess_get_successful (subprocess);
+}
+
+/* `xbps-query -S` succeeds only when the package is registered in the
+ * package database; `-R` would also succeed for packages that are merely
+ * available from a repository. */
+gboolean
+gs_xbps_package_is_installed (const gchar *name)
+{
+	const gchar *argv[] = { "/usr/bin/xbps-query", "-S", name, NULL };
+	g_autoptr(GSubprocess) subprocess = NULL;
+	g_autoptr(GError) local_error = NULL;
+	g_autofree gchar *stdout_buf = NULL;
+	g_autofree gchar *stderr_buf = NULL;
+
+	g_return_val_if_fail (name != NULL, FALSE);
+
+	subprocess = g_subprocess_newv (argv,
+					G_SUBPROCESS_FLAGS_STDOUT_PIPE |
+					G_SUBPROCESS_FLAGS_STDERR_PIPE,
+					&local_error);
+	if (subprocess == NULL) {
+		g_debug ("Failed to run xbps-query: %s", local_error->message);
+		return FALSE;
+	}
+
+	if (!g_subprocess_communicate_utf8 (subprocess, NULL, NULL,
+					    &stdout_buf, &stderr_buf, &local_error)) {
+		g_debug ("Failed to run xbps-query: %s", local_error->message);
+		return FALSE;
+	}
+
+	return g_subprocess_get_successful (subprocess);
+}
+
+void
+gs_xbps_run_async (const gchar * const *argv,
+		   GCancellable *cancellable,
+		   GAsyncReadyCallback callback,
+		   gpointer user_data)
+{
+	g_autoptr(GSubprocessLauncher) launcher = NULL;
+	g_autoptr(GSubprocess) subprocess = NULL;
+	g_autoptr(GError) local_error = NULL;
+
+	g_return_if_fail (argv != NULL && argv[0] != NULL);
+
+	launcher = g_subprocess_launcher_new (G_SUBPROCESS_FLAGS_STDOUT_PIPE |
+					      G_SUBPROCESS_FLAGS_STDERR_PIPE);
+	/* Keep diagnostics parseable regardless of the user's locale. */
+	g_subprocess_launcher_setenv (launcher, "LC_ALL", "C", TRUE);
+
+	subprocess = g_subprocess_launcher_spawnv (launcher, argv, &local_error);
+	if (subprocess == NULL) {
+		g_autoptr(GTask) task = g_task_new (NULL, cancellable, callback, user_data);
+		g_task_set_source_tag (task, gs_xbps_run_async);
+		g_task_return_error (task, g_steal_pointer (&local_error));
+		return;
+	}
+
+	g_subprocess_communicate_utf8_async (subprocess, NULL, cancellable,
+					     callback, user_data);
+}
+
+gboolean
+gs_xbps_run_finish (GAsyncResult *result,
+		    gchar **out_stdout,
+		    gchar **out_stderr,
+		    GError **error)
+{
+	g_autoptr(GObject) source = g_async_result_get_source_object (result);
+	GSubprocess *subprocess = NULL;
+	g_autofree gchar *stdout_buf = NULL;
+	g_autofree gchar *stderr_buf = NULL;
+	gboolean success;
+
+	g_return_val_if_fail (G_IS_ASYNC_RESULT (result), FALSE);
+
+	if (out_stdout != NULL)
+		*out_stdout = NULL;
+	if (out_stderr != NULL)
+		*out_stderr = NULL;
+
+	/* No source object: the subprocess was never spawned. */
+	if (source == NULL)
+		return g_task_propagate_boolean (G_TASK (result), error);
+
+	subprocess = G_SUBPROCESS (source);
+	success = g_subprocess_communicate_utf8_finish (subprocess, result,
+							&stdout_buf, &stderr_buf,
+							error);
+
+	/* communicate_utf8_finish() returns TRUE once both pipes have been
+	 * drained, no matter how the child exited, so the exit status has to
+	 * be checked separately. Without this a refused pkexec prompt (126 or
+	 * 127) or a failed xbps transaction is reported to the caller as a
+	 * successful operation. */
+	if (success && !g_subprocess_get_successful (subprocess)) {
+		g_autofree gchar *detail = NULL;
+		g_autofree gchar *message = NULL;
+		gint exit_status = -1;
+		GIOErrorEnum error_code = G_IO_ERROR_FAILED;
+
+		if (g_subprocess_get_if_exited (subprocess))
+			exit_status = g_subprocess_get_exit_status (subprocess);
+
+		if (exit_status == 126 || exit_status == 127) {
+			/* pkexec: the polkit prompt was dismissed or refused. */
+			error_code = G_IO_ERROR_PERMISSION_DENIED;
+			message = g_strdup_printf ("xbps was not authorized "
+						   "(exit status %d)", exit_status);
+		} else if (exit_status >= 0) {
+			message = g_strdup_printf ("xbps command failed "
+						   "with exit status %d", exit_status);
+		} else {
+			message = g_strdup_printf ("xbps command was terminated "
+						   "by signal %d",
+						   g_subprocess_get_term_sig (subprocess));
+		}
+
+		/* Keep the tool's own diagnostics: the list and refine
+		 * paths only log the GError message. */
+		if (stderr_buf != NULL && *stderr_buf != '\0')
+			detail = g_strstrip (g_strdup (stderr_buf));
+
+		if (detail != NULL && *detail != '\0') {
+			g_set_error (error, G_IO_ERROR, error_code,
+				     "%s: %s", message, detail);
+		} else {
+			g_set_error_literal (error, G_IO_ERROR, error_code,
+					     message);
+		}
+
+		success = FALSE;
+	}
+
+	if (out_stdout != NULL)
+		*out_stdout = g_steal_pointer (&stdout_buf);
+	if (out_stderr != NULL)
+		*out_stderr = g_steal_pointer (&stderr_buf);
+
+	return success;
+}
