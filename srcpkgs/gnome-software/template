# Template file for 'gnome-software'
pkgname=gnome-software
version=50.2
revision=10
build_style=meson
configure_args="-Dpackagekit=false -Dfwupd=false
 -Dmalcontent=false -Dwebapps=false $(vopt_bool gtk_doc)
 -Dhardcoded_foss_webapps=false -Dhardcoded_proprietary_webapps=false
 -Dxbps=true"
hostmakedepends="pkg-config tar glib-devel gettext libxslt docbook-xsl
 $(vopt_if gtk_doc gtk-doc) AppStream itstool"
makedepends="AppStream-devel libxmlb-devel
 json-glib-devel gtk4-devel libadwaita-devel gsettings-desktop-schemas-devel
 gspell-devel polkit-devel flatpak-devel libgudev-devel libsoup3-devel"
depends="gnome-app-list polkit"
checkdepends="dbus"
short_desc="GNOME Software Center (flatpak and xbps)"
maintainer="Void Linux Stores <noreply@github.com>"
license="GPL-3.0-or-later"
homepage="https://gitlab.gnome.org/GNOME/gnome-software"
changelog="https://gitlab.gnome.org/GNOME/gnome-software/-/raw/main/NEWS"
distfiles="https://gitlab.gnome.org/GNOME/gnome-software/-/archive/${version}/gnome-software-${version}.tar.gz"
checksum=b6500da19825e59bb4df167dad2792f31387a6b0ff298bc0357903f4fa804e3c
make_check=no # Requires system dbus

build_options="gtk_doc"

if [ -z "$CROSS_BUILD" ]; then
	build_options_default+=" gtk_doc"
fi

# The xbps backend is carried as a patch against the 50.2 tree; the patch adds
# plugins/xbps/ and the -Dxbps meson option (default OFF upstream of this
# package, enabled here).  The polkit actions are installed below.
#
# gnome-software-xbps-refresh is the root helper behind the fourth
# (allow_active) action: the plugin runs it through pkexec in
# refresh_metadata_async, because `xbps-install -nSu` reads the cached
# repodata and never syncs it.  It takes no arguments and can only run a bare
# `xbps-install -S`; see the policy file header for why that grant is narrow.
post_install() {
	install -Dm644 ${FILESDIR}/gs-xbps.policy \
		${DESTDIR}/usr/share/polkit-1/actions/org.gnome.Software.xbps.policy
	install -Dm755 ${FILESDIR}/gnome-software-xbps-refresh \
		${DESTDIR}/usr/libexec/gnome-software-xbps-refresh

	# [UPDATE-NOTIFIER] On a GNOME session the shell keeps the
	# org.gnome.Software D-Bus name alive, so gs-update-monitor -- which is
	# created unconditionally in GsApplication::startup -- is running and its
	# periodic "updates available" GNotification appears.  Void's other
	# desktops (KDE Plasma, XFCE, ...) have no such activator: nothing ever
	# starts the service, the monitor never runs, and no notification can
	# ever be emitted.  This XDG autostart entry is the descriptor-agnostic
	# launcher -- it is exactly the invocation the shipped D-Bus .service
	# file uses (Exec=@bindir@/gnome-software --gapplication-service).
	#
	# It deliberately carries no OnlyShowIn: the point is to work where the
	# D-Bus activation does not.  X-GNOME-UsesNotifications is set so the
	# desktop's session manager knows the process wants to notify.
	#
	# No password prompt results from the background start: the monitor's
	# metadata refresh runs the org.gnome.Software.xbps.refresh action, which
	# is allow_active=yes (see gs-xbps.policy) -- it only re-syncs the xbps
	# repodata through /usr/libexec/gnome-software-xbps-refresh.  The
	# install/remove/update actions stay auth_admin and are only ever reached
	# from a user gesture.
	install -Dm644 ${FILESDIR}/gnome-software-autostart.desktop \
		${DESTDIR}/etc/xdg/autostart/org.gnome.Software.desktop
}

do_check() {
	# machine-id is a random, non-zero value
	echo 'dcb30309cd6c8b7cc20383d85a5c7012' > /etc/machine-id
	dbus-run-session meson test -C build --no-suite fedora-langpacks
	rm /etc/machine-id
}

gnome-software-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		if [ "$build_option_gtk_doc" ]; then
			vmove usr/share/gtk-doc
		fi
	}
}
